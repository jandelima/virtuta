# ---------- Virtuta: configuração ----------
# Copie para .env e preencha. Na VPS, o docker-compose.yml lê este mesmo arquivo.

# Domínios apontados (DNS tipo A) para o IP da VPS. O HTTPS é gerado sozinho pelo Caddy.
APP_DOMAIN=escritorio.suaempresa.com.br
LIVEKIT_DOMAIN=lk.escritorio.suaempresa.com.br

# Login Google (console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth)
# URI de redirecionamento autorizado: https://<APP_DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Só contas deste domínio entram
ALLOWED_DOMAIN=suaempresa.com.br
# E-mails que já entram como administração (separados por vírgula).
# Se ficar vazio, a primeira pessoa a entrar vira administração.
ADMIN_EMAILS=

# LiveKit: gere uma chave e um segredo longos (ex.: openssl rand -hex 24)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Opcional: onde o servidor fala com a API do LiveKit para tirar alguém de uma sala de mídia.
# Por padrão é o próprio LIVEKIT_URL em http(s); na VPS pode ser http://127.0.0.1:7880.
# LIVEKIT_API_URL=http://127.0.0.1:7880

OFFICE_NAME=Virtuta

# Só para desenvolvimento local: login sem Google. Nunca ligar em produção.
DEV_LOGIN=0
